# Copy via scripts/bootstrap.ps1. Import a separate Proton credential before startup.
PROJECT_NAME=anonexplo
SEARXNG_UI_PORT=8085
HOST_GATEWAY_IMAGE=nginx:stable-alpine@sha256:a8b39bd9cf0f83869a2162827a0caf6137ddf759d50a171451b335cecc87d236
SEARXNG_SECRET=replace-with-local-random-secret
SEARXNG_IMAGE=searxng/searxng:latest@sha256:3547509b419cd6a67333d6d68bd1ffad8d46d3669d82e7a7bd538f7b45827432
SEARCH_VPN_IMAGE=qmcgaw/gluetun:v3.40.0@sha256:2b42bfa046757145a5155acece417b65b4443c8033fb88661a8e9dcf7fda5a00
PROTON_SERVER_COUNTRIES=Switzerland
# Windows Compose file separator. Startup script also selects these explicitly.
COMPOSE_FILE=docker-compose.yml;docker-compose.proton-search.yml
COMPOSE_PROFILES=proton-search
# Engine/language preferences belong in configs/searxng/settings.yml, not here.
# WireGuard key stays in data/proton/wireguard/wg0.conf, never environment metadata.
