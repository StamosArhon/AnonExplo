# Copy this file to .env before running the stack.

PROJECT_NAME=anonexplo
UI_PORT=3000
BACKEND_PORT=8000
SEARXNG_UI_PORT=8085
FETCHER_PORT=8081
HOST_GATEWAY_IMAGE=nginx:stable-alpine@sha256:a8b39bd9cf0f83869a2162827a0caf6137ddf759d50a171451b335cecc87d236

API_PREFIX=/api/v1
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

MODEL_PROVIDER=openai_compatible
# Alternative local example: MODEL_PROVIDER=ollama with MODEL_BASE_URL=http://host.docker.internal:11434/api
MODEL_BASE_URL=http://model-backend:8080/v1
MODEL_NAME=qwen2.5-7b-instruct-q4_k_m
MODEL_REQUEST_TIMEOUT_SECONDS=90
MODEL_PROBE_TIMEOUT_SECONDS=5
MODEL_RUNTIME_PROFILE=llama.cpp-cuda
MODEL_RUNTIME_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda@sha256:59c2b6abd3c898e8f3b7beef3e2c871488d9a9783b6c6d766ffb1409e11c8044
MODEL_FILE_NAME=Qwen2.5-7B-Instruct.Q4_K_M.gguf
MODEL_FILE_SHA256=4e9221217000d0fc8f5ffdbae51a7201fcc3613de18ff1b1cd8c7c01f924437b
MODEL_SOURCE_URL=https://huggingface.co/QuantFactory/Qwen2.5-7B-Instruct-GGUF/resolve/main/Qwen2.5-7B-Instruct.Q4_K_M.gguf?download=true
MODEL_CONTEXT_SIZE=4096
MODEL_GPU_LAYERS=99
MODEL_THREADS=8
MODEL_BATCH_SIZE=512
MODEL_RUNTIME_GPUS=all

SEARCH_PROVIDER=searxng
# Alternative local example: SEARCH_PROVIDER=yacy with SEARCH_BASE_URL=http://yacy-search:8090
SEARCH_BASE_URL=http://search-provider:8080
SEARCH_RESULT_LIMIT=8
SEARCH_CATEGORIES=general,news
SEARCH_LANGUAGE=all
SEARCH_TIME_RANGE=
SEARCH_ENGINES=
SEARCH_REQUEST_TIMEOUT_SECONDS=20
SEARXNG_SECRET=replace-with-local-random-secret
SEARXNG_IMAGE=searxng/searxng:latest@sha256:00b57726b3d732c11f874af964ce68c9e5c38c02d73040567603c0681f0b6007

FETCH_BASE_URL=http://fetcher:8081
FETCH_REQUEST_TIMEOUT_SECONDS=20
FETCH_MAX_RESPONSE_BYTES=2000000
FETCH_MAX_TEXT_CHARS=40000
FETCH_USER_AGENT=AnonExploFetcher/0.1
GROUNDING_SOURCE_CHAR_LIMIT=3000
GROUNDING_TOTAL_CONTEXT_CHARS=9000
GROUNDING_PREVIEW_CHARS=1200
GROUNDING_MODEL_TEMPERATURE=0.1
